# Flask backend — copy to `.env` and adjust values.
# Existing keys (keep your current values):
# SECRET_KEY=
# JWT_SECRET_KEY=
# DATABASE_URI=mysql+pymysql://user:pass@localhost/task_db

# --- Employee monitor API (desktop agent + analytics) ---
# Idle before marking session as idle (seconds)
MONITOR_IDLE_THRESHOLD_SECONDS=30
# Agent heartbeat considered stale after (seconds) → live state "unknown"
MONITOR_HEARTBEAT_STALE_SECONDS=120
# Suggested agent heartbeat interval (returned in /monitor/policy)
MONITOR_HEARTBEAT_INTERVAL_SECONDS=45
